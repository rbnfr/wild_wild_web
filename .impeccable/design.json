  "narrative": {
    "northStar": "Cuaderno de campo",
    "overview": "La web es el cuaderno de una etóloga: observación paciente, rigor científico y calidez natural. Papel marfil, tinta verde oscura y una serif editorial que anota con calma. Nada grita; la jerarquía la marcan la tipografía, el aire y las líneas finas, como en una libreta bien ordenada. La fotografía real de Mary es el único gran gesto visual, enmarcada en un arco que recuerda a una ventana abierta al exterior.",
    "keyCharacteristics": [
      "Papel marfil y tinta verde bosque; un solo acento fuerte.",
      "Serif editorial (Newsreader) para titulares, sans humanista (DM Sans) para todo lo demás.",
      "Separadores de línea fina en vez de tarjetas con sombra.",
      "Planos de color a sangre para alternar secciones.",
      "Retrato en arco como firma visual.",
      "Movimiento sutil, solo con puntero preciso y siempre desactivable."
    ],
    "rules": [
      {
        "name": "La regla de la tinta única",
        "body": "El verde bosque es el único color de acento con peso. Los verdes musgo y liquen son detalles puntuales; el ocre solo indica foco.",
        "section": "colors"
      },
      {
        "name": "La regla de los planos",
        "body": "Las secciones se distinguen cambiando el color de fondo a sangre (marfil → salvia → marfil → arena → bosque), nunca con tarjetas flotantes.",
        "section": "colors"
      },
      {
        "name": "La regla de la voz editorial",
        "body": "La serif solo se usa para titulares y para el wordmark; nunca para texto corrido, botones ni formularios.",
        "section": "typography"
      },
      {
        "name": "La regla sin mayúsculas",
        "body": "Las etiquetas y botones van en caja normal, sin versalitas ni espaciado ancho: el tono es conversación, no rótulo.",
        "section": "typography"
      },
      {
        "name": "La regla del aire",
        "body": "Antes de añadir un elemento, se quita otro. El espacio vacío es parte del cuaderno.",
        "section": "layout"
      },
      {
        "name": "La regla del objeto real",
        "body": "Solo la portada del libro recibe tratamiento 3D (rotación, cantos de páginas, brillo), porque es un objeto físico. Ningún otro elemento simula volumen.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar marfil como fondo por defecto y verde bosque como único acento con peso.",
      "Do separar contenidos con líneas de 1 px y planos de color, no con tarjetas.",
      "Do reservar Newsreader para titulares y el wordmark.",
      "Do dejar cada elemento completo en su estado final sin animación; el movimiento solo se añade con prefers-reduced-motion: no-preference, y el hover solo con (hover: hover) and (pointer: fine).",
      "Do mantener objetivos táctiles de 44–48 px y el anillo de foco ocre de 3 px.",
      "Do dar protagonismo a la fotografía real de Mary."
    ],
    "donts": [
      "Don't usar huellas, ilustraciones caricaturescas ni imágenes de banco.",
      "Don't introducir un segundo color de acento ni degradados decorativos.",
      "Don't animar el retrato del hero al cargar: es el elemento LCP.",
      "Don't añadir sombras o efectos 3D a elementos que no sean objetos físicos (la portada del libro).",
      "Don't usar mayúsculas forzadas ni espaciado ancho en etiquetas y botones."
    ]
  }
}
