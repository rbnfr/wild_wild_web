# Copia este archivo como .env.local y rellena los valores reales.
# En producción, estas variables se configuran en el panel del hosting (nunca en el repositorio).
# Todo lo que empieza por NEXT_PUBLIC_ es visible en el navegador: no pongas secretos ahí.

# URL pública del sitio, sin barra final. Se usa en canonical, sitemap, Open Graph y datos estructurados.
# Es un valor de compilación: tras cambiarla hay que volver a desplegar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pon true solo cuando el contenido sea definitivo y el dominio esté listo para indexarse.
# Requiere además una NEXT_PUBLIC_SITE_URL válida: sin ella se mantiene bloqueado.
# Mientras no se active, robots.txt bloquea el sitio y se envía <meta robots noindex>.
ALLOW_INDEXING=false

# --- Formulario de contacto ---
# resend  -> envía el correo con Resend (producción)
# dry-run -> valida todo pero NO envía nada (desarrollo, pruebas, staging)
CONTACT_DELIVERY_MODE=dry-run

# Dirección que recibe los mensajes.
CONTACT_TO_EMAIL=
# Remitente verificado en Resend. Admite "Nombre <correo@dominio.com>".
CONTACT_FROM_EMAIL=
# Clave de API de Resend (secreta).
RESEND_API_KEY=

# --- Anti-spam: Cloudflare Turnstile ---
# Clave pública del widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Clave secreta de verificación (solo servidor).
TURNSTILE_SECRET_KEY=

# --- Limitación de frecuencia (opcional) ---
# Envíos permitidos por IP y duración de la ventana en segundos.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
# Tope global de mensajes enviados por ventana, sumando todas las IP. Protege tu bandeja de entrada
# aunque alguien falsifique su IP.
CONTACT_GLOBAL_RATE_LIMIT_MAX=50
# Número de proxies de confianza que reescriben X-Forwarded-For delante de la aplicación.
# Con 1, la IP del cliente es la última de la cabecera. Pon 0 si la app está expuesta directamente
# (no hay proxy): entonces todas las peticiones comparten un único contador.
TRUSTED_PROXY_HOPS=1
