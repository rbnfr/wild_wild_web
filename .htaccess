# Generated with this export. Upload it together with the HTML.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
<Files "opengraph-image">
ForceType image/png
</Files>
<IfModule mod_mime.c>
AddType image/avif .avif
AddType image/webp .webp
</IfModule>
<IfModule mod_headers.c>
