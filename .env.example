# URL public real in production (origin must match the browser).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local development only. Production requires live credentials regardless of this flag.
CONTACT_EMAIL_MODE=mock
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Enable ONLY when your trusted reverse proxy overwrites x-forwarded-for.
# Without it, requests share one bucket. Multi-instance hosting needs a shared limiter / WAF.
CONTACT_TRUST_PROXY=false
