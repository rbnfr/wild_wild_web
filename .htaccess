# Generated with this export. Upload it together with the HTML.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
<Files "opengraph-image">
ForceType image/png
</Files>
<IfModule mod_alias.c>
# Hidden files (.git from the Git deployment, .htaccess, .env) are never served.
RedirectMatch 404 ^/\.(?!well-known/)
RedirectMatch 301 ^/aviso-legal/?$ /es/aviso-legal/
RedirectMatch 301 ^/privacidad/?$ /es/privacidad/
RedirectMatch 301 ^/cookies/?$ /es/cookies/
</IfModule>
<IfModule mod_mime.c>
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
</IfModule>
<IfModule mod_headers.c>
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cloud.umami.is 'sha256-0Wd+kPZkoJk10o40z3Aand0snWwMJpjispzkbufLBx4=' 'sha256-BILoRKw9Lhqt2H4sm8a9n8z3XstLFIWBUMQ7hifliPA=' 'sha256-CHZiocgp0m8pUHSkDmWniKDiLOj+QWG0bfAY92rRBrs=' 'sha256-ItAkjGjkvvksrCg1NGuuTa2TP4twBYAeBVgsO0f7H8s=' 'sha256-JIyFgBP8muTOU1kqmnWkXQD57XlxehmiL6qOLegmM/k=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-P38cst4Dng+/zKqe7ayQ+9lW1GELnosHrRuM1xaa9PY=' 'sha256-QGDGms1qc9wV0nFA2o88cebdaIi0RX5WscW3yt2iuD4=' 'sha256-QGxEgkuyVk/xM5y3O1joOAn9WuzeMNLyUM/GCLfCX00=' 'sha256-QoW40i914rZ4q9nD/IVrTVMGYWgHhCOydhIEYVKfNjE=' 'sha256-TxKgm2WEU3M7Sy7PLwS1G81rO66Vl399ZBEZhUQf9Yg=' 'sha256-X9pC0a6bGelie6+ZHdwWRYofDznqmpxFCOSG7MAcFYQ=' 'sha256-bO8wZYa+h+uK2EdIBo9SODfibccBu4SCfOdTAk828Qo=' 'sha256-u8llXUaJDUGCvPuRxn6kCjNbqg2GT8ZK+TNSChhf3Hc=' 'sha256-v3PkkpqepXcmDOjaR1SwsthKJDox6D/pZqefoZ4K0rI='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://gateway.umami.is; worker-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
<FilesMatch "\.html$">
Header set Link "</llms.txt>; rel=describedby"
</FilesMatch>
<FilesMatch "\.(?:html|txt|xml)$">
Header set Cache-Control "no-cache"
</FilesMatch>
# Hash-named assets (Next.js chunks, fonts, generated image variants).
<FilesMatch "\.(?:js|css|woff2|avif|webp)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/avif "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 hour"
ExpiresByType image/png "access plus 1 hour"
ExpiresByType image/svg+xml "access plus 1 hour"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>
